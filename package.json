  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "run-s check:audio-textures build:icons dev:astro",
    "build": "run-s check:audio-textures build:icons build:astro build:pagefind",
    "build:audio-textures": "node scripts/generate-audio-textures.mjs",
    "check:audio-textures": "node scripts/generate-audio-textures.mjs --check",
    "build:icons": "node scripts/generate-icon-data.mjs",
    "build:pagefind": "node scripts/patch-pagefind-lang.mjs && pagefind --site out --output-path out/pagefind --glob \"**/*.html\"",
    "pagefind:dev": "node scripts/pagefind-dev.mjs",
    "pagefind:dev:force": "node scripts/pagefind-dev.mjs --force",
    "start": "astro preview",
    "lint": "run-s lint:code lint:fsd lint:unused",
    "lint:code": "vp lint --tsconfig ./tsconfig.json .",
    "lint:fsd": "steiger ./src/foundation",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "prepare": "husky",
    "precommit": "npm run lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && astro check --tsconfig tsconfig.astro.json",
    "react-doctor": "react-doctor . -y",
    "lint:unused": "fallow dead-code",
    "dev:astro": "astro dev --host 127.0.0.1",
    "build:astro": "astro build",
    "preview:astro": "astro preview --host 127.0.0.1",
    "typecheck:astro": "astro check --tsconfig tsconfig.astro.json",
    "test:astro": "node --test scripts/astro-preview.test.mts"
  },
